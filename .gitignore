# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# regenerable scrape/AI-call caches (not source data)
/data/cache/

# live-updating local state (daily snapshot, no generator — future Supabase migration candidate)
/data/follower-history.json

# typescript
*.tsbuildinfo
next-env.d.ts
public/viral-reels/
